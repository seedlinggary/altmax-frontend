# Resend (https://resend.com) — used by /api/contact to send proposal-request emails
RESEND_API_KEY=

# The email address that should receive new proposal requests (e.g. info@altmaxny.com)
CONTACT_TO_EMAIL=

# The "from" address used when sending — must be on a domain you've verified in Resend
# (e.g. Altmax Website <proposals@altmaxny.com>). Until a domain is verified, Resend
# only allows sending from onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# Optional: used for canonical URLs / sitemap generation
SITE_URL=https://www.altmaxny.com
